{
  "name": "@knyazevai/dsh-tool-present",
  "description": "Explicit workspace file delivery declarations for the DeepSeek Harness",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/deliverables/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-agent": "workspace:*",
    "@knyazevai/dsh-fs": "workspace:*",
    "@knyazevai/dsh-llm": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-session-projection": "workspace:*",
    "@knyazevai/dsh-tools": "workspace:*",
    "@knyazevai/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-agent": "workspace:*",
    "@knyazevai/dsh-fs": "workspace:*",
    "@knyazevai/dsh-llm": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-session-projection": "workspace:*",
    "@knyazevai/dsh-tools": "workspace:*",
    "@knyazevai/dsh-agent-loop": "workspace:*",
    "@knyazevai/dsh-agent-loop-testkit": "workspace:*",
    "@knyazevai/dsh-fs-local": "workspace:*",
    "@knyazevai/dsh-system-prompt": "workspace:*",
    "@knyazevai/dsh-scope": "workspace:*",
    "@knyazevai/dsh-working-directory": "workspace:*"
  }
}

{
  "name": "@knyazevai/dsh-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@knyazevai/dsh-agent": "workspace:^",
    "@knyazevai/dsh-shell": "workspace:^",
    "@knyazevai/dsh-shell-env": "workspace:^",
    "@knyazevai/dsh-invariants": "workspace:^",
    "@knyazevai/dsh-llm": "workspace:^",
    "@knyazevai/dsh-sandbox": "workspace:^",
    "@knyazevai/dsh-sandbox-policy": "workspace:^",
    "@knyazevai/dsh-system-prompt": "workspace:^",
    "@knyazevai/dsh-jobs": "workspace:^",
    "@knyazevai/dsh-tools": "workspace:^",
    "@knyazevai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@knyazevai/dsh-agent": "workspace:^",
    "@knyazevai/dsh-agent-loop": "workspace:^",
    "@knyazevai/dsh-agent-loop-testkit": "workspace:^",
    "@knyazevai/dsh-shell": "workspace:^",
    "@knyazevai/dsh-shell-env": "workspace:^",
    "@knyazevai/dsh-bash-local": "workspace:^",
    "@knyazevai/dsh-invariants": "workspace:^",
    "@knyazevai/dsh-llm": "workspace:^",
    "@knyazevai/dsh-subprocess-local": "workspace:^",
    "@knyazevai/dsh-sandbox": "workspace:^",
    "@knyazevai/dsh-sandbox-policy": "workspace:^",
    "@knyazevai/dsh-session": "workspace:^",
    "@knyazevai/dsh-session-persistence-jsonl": "workspace:^",
    "@knyazevai/dsh-system-prompt": "workspace:^",
    "@knyazevai/dsh-jobs": "workspace:^",
    "@knyazevai/dsh-jobs-local": "workspace:^",
    "@knyazevai/dsh-tool-jobs": "workspace:^",
    "@knyazevai/dsh-tools": "workspace:^",
    "@knyazevai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}

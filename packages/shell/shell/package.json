{
  "name": "@knyazevai/dsh-shell",
  "description": "Abstract bash executor seam (ctx.shell) for the DeepSeek Harness",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/shell"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@knyazevai/dsh-subprocess": "workspace:^",
    "@knyazevai/dsh-sandbox": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@knyazevai/dsh-settings": "workspace:^"
  },
  "devDependencies": {
    "@knyazevai/dsh-subprocess": "workspace:^",
    "@knyazevai/dsh-sandbox": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@knyazevai/dsh-settings": "workspace:^"
  }
}

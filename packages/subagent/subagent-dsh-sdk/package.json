{
  "name": "@knyazevai/dsh-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@knyazevai/dsh-agent": "workspace:^",
    "@knyazevai/dsh-llm": "workspace:^",
    "@knyazevai/dsh-sdk-client": "workspace:^",
    "@knyazevai/dsh-session": "workspace:^",
    "@knyazevai/dsh-subagent": "workspace:^",
    "@knyazevai/dsh-subprocess": "workspace:^"
  },
  "dependencies": {
    "@knyazevai/dsh-brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@knyazevai/dsh-agent": "workspace:^",
    "@knyazevai/dsh-agent-instructions": "workspace:^",
    "@knyazevai/dsh-app-boot": "workspace:^",
    "@knyazevai/dsh-llm": "workspace:^",
    "@knyazevai/dsh-llm-deepseek": "workspace:^",
    "@knyazevai/dsh-loader-smoke": "workspace:^",
    "@knyazevai/dsh-sdk-client": "workspace:^",
    "@knyazevai/dsh-sdk-protocol": "workspace:^",
    "@knyazevai/dsh-session": "workspace:^",
    "@knyazevai/dsh-session-checkpoint-policy": "workspace:^",
    "@knyazevai/dsh-session-persistence-jsonl": "workspace:^",
    "@knyazevai/dsh-session-projection": "workspace:^",
    "@knyazevai/dsh-skill-filesystem": "workspace:^",
    "@knyazevai/dsh-subagent": "workspace:^",
    "@knyazevai/dsh-subprocess": "workspace:^",
    "@knyazevai/dsh-system-prompt": "workspace:^",
    "@knyazevai/dsh-tool-subagent": "workspace:^"
  }
}

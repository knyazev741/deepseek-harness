{
  "name": "@knyazevai/dsh-cua",
  "description": "Shared Computer Use application objects, authorization, and logged tool execution",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./native-client": {
      "types": "./lib/types/native-client.d.ts",
      "default": "./lib/native-client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/api.js",
    "lib/bridge.js",
    "lib/native-client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-computer-use": "workspace:*",
    "@knyazevai/dsh-system-prompt": "workspace:*",
    "@knyazevai/dsh-tools": "workspace:*",
    "@knyazevai/dsh-agent": "workspace:*",
    "@knyazevai/dsh-subprocess": "workspace:*",
    "@knyazevai/dsh-user-questions": "workspace:*",
    "@knyazevai/dsh-attachment": "workspace:*",
    "@knyazevai/dsh-llm": "workspace:*"
  },
  "dependencies": {
    "@knyazevai/dsh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@knyazevai/dsh-brand": "workspace:*",
    "@knyazevai/dsh-atomic-write": "workspace:*"
  },
  "devDependencies": {
    "@knyazevai/dsh-working-directory": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@knyazevai/dsh-agent": "workspace:*",
    "@knyazevai/dsh-agent-loop": "workspace:*",
    "@knyazevai/dsh-agent-loop-testkit": "workspace:*",
    "@knyazevai/dsh-attachment": "workspace:*",
    "@knyazevai/dsh-attachment-local": "workspace:*",
    "@knyazevai/dsh-computer-use": "workspace:*",
    "@knyazevai/dsh-llm": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-session-projection": "workspace:*",
    "@knyazevai/dsh-system-prompt": "workspace:*",
    "@knyazevai/dsh-tools": "workspace:*",
    "@knyazevai/dsh-subprocess": "workspace:*",
    "@knyazevai/dsh-subprocess-local": "workspace:*",
    "@knyazevai/dsh-fs-local": "workspace:*",
    "@knyazevai/dsh-llm-deepseek": "workspace:*",
    "@knyazevai/dsh-ptc-runtime-node": "workspace:*",

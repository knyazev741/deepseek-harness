{
  "name": "@knyazevai/dsh-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the DeepSeek Harness interception seams",
  "version": "0.2.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@knyazevai/dsh-agent": "workspace:*",
    "@knyazevai/dsh-hook-protocol": "workspace:*",
    "@knyazevai/dsh-llm": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-session-projection": "workspace:*",
    "@knyazevai/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@knyazevai/dsh-agent": "workspace:*",
    "@knyazevai/dsh-agent-loop": "workspace:*",
    "@knyazevai/dsh-agent-loop-testkit": "workspace:*",
    "@knyazevai/dsh-shell": "workspace:*",
    "@knyazevai/dsh-bash-local": "workspace:*",
    "@knyazevai/dsh-subprocess-local": "workspace:*",
    "@knyazevai/dsh-hook-protocol": "workspace:*",
    "@knyazevai/dsh-llm": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-session-persistence-jsonl": "workspace:*",
    "@knyazevai/dsh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-session-projection": "workspace:*",
    "@knyazevai/dsh-working-directory": "workspace:*"
  }
}

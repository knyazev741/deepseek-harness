{
  "name": "@knyazevai/dsh-webhook-github",
  "description": "Signed GitHub HTTP webhook adapter for the DeepSeek Harness webhook runtime",
  "version": "0.2.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/webhook-github"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./examples/*": "./examples/*"
  },
  "files": [
    "lib/index.js",
    "examples/github-review/cordis.yml",
    "examples/github-review/github-ready-review-rule.mjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-credentials": "workspace:*",
    "@knyazevai/dsh-host-webserver": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-webhook": "workspace:*"
  },
  "dependencies": {
    "@knyazevai/dsh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@octokit/webhooks": "^14.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@knyazevai/dsh-credentials": "workspace:*",
    "@knyazevai/dsh-host-webserver": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-webhook": "workspace:*"
  }
}

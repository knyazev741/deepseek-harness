{
  "name": "@knyazevai/dsh-experimental-client-ui-cot-translation",
  "description": "Optional machine translation of expanded reasoning, preserving original Session text",
  "version": "0.2.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/client-ui-cot-translation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@knyazevai/dsh-api-remotes",
        "@knyazevai/dsh-client-locale",
        "@knyazevai/dsh-client-ui-chat",
        "@knyazevai/dsh-client-ui-plugin-manager",
        "@knyazevai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-experimental-translator": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@knyazevai/dsh-typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-settings": "workspace:*",
    "@knyazevai/dsh-experimental-translator": "workspace:*",
    "@knyazevai/dsh-api-remotes": "workspace:*",
    "@knyazevai/dsh-client-locale": "workspace:*",
    "@knyazevai/dsh-client-store": "workspace:*",
    "@knyazevai/dsh-client-test-runtime": "workspace:*",
    "@knyazevai/dsh-client-ui-chat": "workspace:*",
    "@knyazevai/dsh-client-ui-plugin-manager": "workspace:*",
    "@knyazevai/dsh-client-ui-primitives": "workspace:*",
    "@knyazevai/dsh-client-ui-renderer": "workspace:*",
    "@knyazevai/dsh-client-ui-settings": "workspace:*",
    "@knyazevai/dsh-client-ui-slots": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.3.3",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-api-remote-access": "workspace:*",
    "@knyazevai/dsh-api-session-controller": "workspace:*",
    "@knyazevai/dsh-agent-loop-testkit": "workspace:*",
    "@knyazevai/dsh-session-persistence-jsonl": "workspace:*",
    "@knyazevai/dsh-session-query": "workspace:*",
    "@knyazevai/dsh-typert-registry": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}

{
  "name": "@knyazevai/dsh-ptc-runtime-node",
  "description": "Sandboxed Node process implementation of the DeepSeek Harness PTC execution capability",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@knyazevai/dsh-ptc-runtime": "workspace:^",
    "@knyazevai/dsh-session": "workspace:^",
    "@knyazevai/dsh-timeout": "workspace:^",
    "@knyazevai/dsh-fs": "workspace:^",
    "@knyazevai/dsh-subprocess": "workspace:^",
    "@knyazevai/dsh-sandbox": "workspace:^",
    "@knyazevai/dsh-sandbox-policy": "workspace:^"
  },
  "dependencies": {
    "@knyazevai/dsh-util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@knyazevai/dsh-ptc-runtime": "workspace:^",
    "@knyazevai/dsh-session": "workspace:^",
    "@knyazevai/dsh-timeout": "workspace:^",
    "@knyazevai/dsh-fs": "workspace:^",
    "@knyazevai/dsh-subprocess": "workspace:^",
    "@knyazevai/dsh-sandbox": "workspace:^",
    "@knyazevai/dsh-sandbox-policy": "workspace:^",
    "@knyazevai/dsh-fs-local": "workspace:^",
    "@knyazevai/dsh-subprocess-local": "workspace:^",
    "@knyazevai/dsh-session-projection": "workspace:^",
    "@knyazevai/dsh-sandbox-local": "workspace:^"
  }
}

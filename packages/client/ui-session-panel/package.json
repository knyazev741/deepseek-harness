{
  "name": "@knyazevai/dsh-client-ui-session-panel",
  "description": "Floating Session panel opened from the Session header, composed of sections that plugins register",
  "version": "0.2.10",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-session-panel"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-api-remotes": "workspace:*",
    "@knyazevai/dsh-api-session-controller": "workspace:*",
    "@knyazevai/dsh-api-workspace-controller": "workspace:*",
    "@knyazevai/dsh-client-connection": "workspace:*",
    "@knyazevai/dsh-client-locale": "workspace:*",
    "@knyazevai/dsh-client-store": "workspace:*",
    "@knyazevai/dsh-client-test-runtime": "workspace:*",
    "@knyazevai/dsh-client-ui-chat": "workspace:*",
    "@knyazevai/dsh-client-ui-context-menu": "workspace:*",
    "@knyazevai/dsh-client-ui-conversation": "workspace:*",
    "@knyazevai/dsh-client-ui-primitives": "workspace:*",
    "@knyazevai/dsh-client-ui-renderer": "workspace:*",
    "@knyazevai/dsh-client-ui-session": "workspace:*",
    "@knyazevai/dsh-client-ui-slots": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-util-workspace-path": "workspace:*",
    "@knyazevai/dsh-working-directory": "workspace:*",
    "@knyazevai/dsh-workspace": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@knyazevai/dsh-api-remotes",
        "@knyazevai/dsh-client-connection",
        "@knyazevai/dsh-client-locale",
        "@knyazevai/dsh-client-ui-chat",
        "@knyazevai/dsh-client-ui-context-menu",
        "@knyazevai/dsh-client-ui-conversation",
        "@knyazevai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}

{
  "name": "@knyazevai/dsh-client-ui-sidebar-documentpreview",
  "description": "Extensible Sidebar previews for Office documents, spreadsheets, Markdown, code, images, PDF, HTML, and plain text",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-documentpreview"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@knyazevai/dsh-api-gateway",
        "@knyazevai/dsh-api-workspace-files",
        "@knyazevai/dsh-client-resources",
        "@knyazevai/dsh-client-ui-sidebar-right",
        "@knyazevai/dsh-client-ui-session",
        "@knyazevai/dsh-api-remotes",
        "@knyazevai/dsh-client-locale",
        "@knyazevai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@knyazevai/dsh-api-gateway": "workspace:*",
    "@knyazevai/dsh-api-remotes": "workspace:*",
    "@knyazevai/dsh-api-workspace-files": "workspace:*",
    "@knyazevai/dsh-client-connection": "workspace:*",
    "@knyazevai/dsh-client-locale": "workspace:*",
    "@knyazevai/dsh-client-resources": "workspace:*",
    "@knyazevai/dsh-client-store": "workspace:*",
    "@knyazevai/dsh-client-test-runtime": "workspace:*",
    "@knyazevai/dsh-client-ui-dockkit": "workspace:*",
    "@knyazevai/dsh-client-ui-primitives": "workspace:*",
    "@knyazevai/dsh-client-ui-renderer": "workspace:*",
    "@knyazevai/dsh-client-ui-session": "workspace:*",
    "@knyazevai/dsh-client-ui-settings": "workspace:*",
    "@knyazevai/dsh-client-ui-sidebar-right": "workspace:*",
    "@knyazevai/dsh-client-ui-slots": "workspace:*",
    "@knyazevai/dsh-office-to-pdf": "workspace:*",
    "@knyazevai/dsh-host-webserver": "workspace:*",
    "@knyazevai/dsh-office-to-pdf": "workspace:*",
    "@knyazevai/dsh-session": "workspace:*",
    "@knyazevai/dsh-util-workspace-path": "workspace:*",
    "@fortune-sheet/core": "1.0.4",
    "@fortune-sheet/react": "1.0.4",
    "@testing-library/react": "^16.1.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.4.11",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "^0.8.3",
    "papaparse": "5.5.3",
    "pdfjs-dist": "6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  }
}

    "@knyazevai/dsh-tool-executor-native": "workspace:*",
    "@knyazevai/dsh-tool-testkit": "workspace:*",
    "@knyazevai/dsh-tools": "workspace:*",
    "@knyazevai/dsh-user-questions": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  }

{
  "name": "@knyazevai/dsh-tool-lsp",
  "description": "Model-facing lsp tool over the DeepSeek Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@knyazevai/dsh-llm": "workspace:^",
    "@knyazevai/dsh-lsp": "workspace:^",
    "@knyazevai/dsh-system-prompt": "workspace:^",
    "@knyazevai/dsh-timeout": "workspace:^",
    "@knyazevai/dsh-tools": "workspace:^"
  },
  "dependencies": {
    "@knyazevai/dsh-util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@knyazevai/dsh-agent": "workspace:^",
    "@knyazevai/dsh-fs-local": "workspace:^",
    "@knyazevai/dsh-llm": "workspace:^",
    "@knyazevai/dsh-lsp": "workspace:^",
    "@knyazevai/dsh-lsp-stdio": "workspace:^",
    "@knyazevai/dsh-session": "workspace:^",
    "@knyazevai/dsh-subprocess-local": "workspace:^",
    "@knyazevai/dsh-system-prompt": "workspace:^",
    "@knyazevai/dsh-timeout": "workspace:^",
    "@knyazevai/dsh-tool-call-timeout-policy": "workspace:^",
    "@knyazevai/dsh-tools": "workspace:^"
  }
}
